# --- Better Auth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-min-32-chars
# Public base URL of this Next.js app
BETTER_AUTH_URL=http://localhost:3000

# --- Database (used by Better Auth for user/session/account/verification) ---
# Same PostgreSQL instance as the FastAPI backend. Better Auth tables coexist in the same
# database (or use a separate schema via ?options=-csearch_path%3Dauth). No separate DB needed.
# Local docker: docker run --rm -p 5432:5432 -e POSTGRES_PASSWORD=dev -e POSTGRES_DB=refuce postgres:16
DATABASE_URL=postgresql://postgres:dev@localhost:5432/refuce

# --- Microsoft Entra ID (Azure AD) SSO ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Use your tenant id; "common" allows multi-tenant + personal accounts
MICROSOFT_TENANT_ID=common

# --- FastAPI backend integration ---
# URL the Next.js server uses to talk to the Python backend
BACKEND_API_URL=http://localhost:8000
# Shared HMAC secret for signing forwarded user identity (must match backend)
BACKEND_SHARED_SECRET=replace-me-with-strong-secret

# Legacy public URL — kept for compatibility with the old client; not required
# once all client API calls go through the /api/[...path] proxy.
# NEXT_PUBLIC_API_URL=http://localhost:8000
