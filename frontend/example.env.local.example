# --- Better Auth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-min-32-chars
# Public base URL of this Next.js app
BETTER_AUTH_URL=http://localhost:3000

# --- Database (used by Better Auth for user/session/account/verification) ---
# Better Auth requires its OWN PostgreSQL database, SEPARATE from FastAPI's database.
# Do NOT point this at the FastAPI database — they are independent stores with no
# cross-database queries.
# Local docker: docker run --rm -p 5432:5432 -e POSTGRES_PASSWORD=dev -e POSTGRES_DB=refuce_auth postgres:16
AUTH_DATABASE_URL=postgresql://postgres:dev@localhost:5432/refuce_auth

# --- Microsoft Entra ID (Azure AD) SSO ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# REQUIRED: set to your organisation's tenant id (NOT "common").
# Using "common" allows ANY Microsoft account to authenticate — a security risk.
MICROSOFT_TENANT_ID=

# --- FastAPI backend integration ---
# URL the Next.js server uses to talk to the Python backend
BACKEND_API_URL=http://localhost:8000
# Shared HMAC secret for signing forwarded user identity (must match backend)
BACKEND_SHARED_SECRET=replace-me-with-strong-secret

# NEXT_PUBLIC_API_URL is removed — the browser only calls /api/*, never the
# backend directly. The backend URL is server-side only (BACKEND_API_URL above).
