# Root .env.example — copy to .env and fill in real values before running docker compose.
# .env is gitignored; this file is the committed template.

# --- Better Auth ---
BETTER_AUTH_SECRET=replace-me-with-a-random-32-byte-string

# --- Backend (FastAPI) ---
SECRET_KEY=replace-me
ADMIN_SECRET=replace-me

# --- Shared HMAC secret (must match on both frontend and backend) ---
BACKEND_SHARED_SECRET=replace-me-with-strong-secret

# --- Microsoft Entra ID SSO ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Set to the Bouvet tenant id — NOT "common"
MICROSOFT_TENANT_ID=
